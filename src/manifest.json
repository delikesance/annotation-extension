{
  "manifest_version": 3,
  "name": "AI Web Annotator",
  "version": "1.6.0",
  "description": "Capturez, annotez interactivement n'importe quelle page web et exportez un contexte structuré pour l'IA.",
  "action": {
    "default_title": "Activer le mode annotation (Freeze)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "update_url": "https://git.delikesance.cloud/delikesance/annotation-extension/raw/branch/main/updates.xml",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://git.delikesance.cloud/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/styles.css",
        "offscreen/offscreen.html",
        "offscreen/offscreen.js",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
