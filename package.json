{
  "name": "ai-web-annotator",
  "version": "1.0.0",
  "description": "Chrome Extension (Manifest V3) to interactively annotate web pages and export structured context for AI",
  "main": "src/background/service-worker.js",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "test": "node --test test/**/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "ai",
    "context",
    "web-annotator",
    "dom-inspector"
  ],
  "author": "delikesance",
  "license": "MIT",
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "jsdom": "^26.0.0"
  }
}
